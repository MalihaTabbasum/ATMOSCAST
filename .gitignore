# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Environment variables & secrets
.env
.env.local
.env.*.local
*.pem
*.key

# Streamlit local settings & secrets
.streamlit/secrets.toml

# AtmosCast Data directories — raw data excluded; processed dataset committed for cloud deployment
data/raw/*
!data/raw/.gitkeep
data/external/*
!data/external/.gitkeep

# Processed data: include the main merged dataset for Streamlit Cloud deployment
# (247 KB — well within GitHub limits; no personal or restricted data)
data/processed/*
!data/processed/.gitkeep
!data/processed/merged_delhi_ncr_hourly.csv

# Machine Learning Models — include trained artifacts for cloud deployment (11.5 MB total)
# Individual large intermediary files remain excluded
models/*.pkl
models/*.pt
models/*.onnx
# Allow .joblib artifacts and model registry (required for ForecastEngine on Streamlit Cloud)
!models/*.joblib
!models/model_registry.json

# Reports and generated exports
reports/*.html
reports/*.pdf
reports/*.png

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
*.py,cover

# Jupyter Notebook checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# IDE and OS files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini
