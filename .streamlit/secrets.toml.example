# AtmosCast — Streamlit Secrets Template
#
# HOW TO USE:
#   Local:          Copy this to .streamlit/secrets.toml and fill in values.
#   Streamlit Cloud: Paste key=value pairs into the Secrets text box in the app settings.
#
# All keys below are OPTIONAL. The application runs fully in offline demo mode
# without any API credentials using the included processed dataset.

# OpenAQ v3 API key (optional — increases rate limit from ~10 to 1000 req/min)
# Register free at https://explore.openaq.org/
OPENAQ_API_KEY = ""

# NASA FIRMS API key (optional — required only for live satellite fire data)
# Register free at https://firms.modaps.eosdis.nasa.gov/api/area/
NASA_FIRMS_MAP_KEY = ""

# CPCB API key (optional — not currently used in v1.0; reserved for future integration)
CPCB_API_KEY = ""
