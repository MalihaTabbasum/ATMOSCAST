# AtmosCast Environment Variables
# Copy this file to .env and fill in your values. Never commit .env to version control!

# Environment mode: development, staging, production
ATMOSCAST_ENV=development

# Base path for local data storage (defaults to 'data')
ATMOSCAST_DATA_DIR=data

# OpenAQ API v3 Key (Optional for basic queries, recommended for higher rate limits)
# Get a key at: https://openaq.org/
OPENAQ_API_KEY=

# NASA FIRMS MAP_KEY for satellite active fire and thermal anomaly data (VIIRS/MODIS)
# Get a key at: https://firms.modaps.eosdis.nasa.gov/api/map_key/
NASA_FIRMS_MAP_KEY=

# CPCB AQI Portal Scraper / API Headers (if applicable)
CPCB_API_KEY=

# Open-Meteo Weather API (Open-Meteo is free for non-commercial use with no key needed)
# Commercial API key if applicable:
OPEN_METEO_API_KEY=

# Log Level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
